<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hr</groupId>
        <artifactId>hr-backend</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>hr-bootstrap</artifactId>
    <name>hr-bootstrap</name>
    <description>启动模块</description>
    <dependencies>
        <dependency>
            <groupId>com.hr</groupId>
            <artifactId>hr-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hr</groupId>
            <artifactId>hr-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hr</groupId>
            <artifactId>hr-demand</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hr</groupId>
            <artifactId>hr-talent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hr</groupId>
            <artifactId>hr-interview</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hr</groupId>
            <artifactId>hr-hire</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hr</groupId>
            <artifactId>hr-dashboard</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hr</groupId>
            <artifactId>hr-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hr</groupId>
            <artifactId>hr-integration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hr</groupId>
            <artifactId>hr-dedup</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <finalName>hr-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
