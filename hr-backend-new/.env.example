# 智能招聘系统 · 部署环境变量模板
# 用法：复制本文件为 .env，填好真实值后放在本目录（与 docker-compose.yml 同级）。
# .env 已被 gitignore 排除，绝不会上传到仓库。
#
# 密钥类请用随机长串生成（Linux/macOS: `openssl rand -hex 32`），
# 不要用下面的示例值，尤其是 JWT_SECRET_KEY 和 PASSWORD_SALT。

# JWT 令牌签名密钥 —— 泄露则任何人可伪造登录态，必须改
JWT_SECRET_KEY=change-me-jwt-secret-please-override

# 密码加盐 —— 用于用户密码哈希，必须改
PASSWORD_SALT=default-salt-change-me

# 数据库（MySQL / RDS）密码
DATABASE_PASSWORD=your-db-password

# DeepSeek API 密钥（AI 简历解析 / 匹配打分 / JD 生成）
DEEPSEEK_API_KEY=sk-your-deepseek-key
