# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Mock fallback — when false (default), DB errors surface as real errors
# Set to true only in dev when the database is unavailable
MOCK_FALLBACK=false

# Database
# Application runtime requires MySQL/MariaDB; local SQLite is disabled.
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/hr_recruit?charset=utf8mb4

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=60

# Password hashing
PASSWORD_SALT=your-password-salt-here

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=86400

# DeepSeek AI — required, no default
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Feishu (set FEISHU_MOCK_MODE=true for dev without real credentials)
FEISHU_MOCK_MODE=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Tencent Meeting
TENCENT_MEETING_MOCK_MODE=false

# IAM Sync
IAM_DB_URL=

# CORS
CORS_ORIGINS=http://127.0.0.1:7100

